# secrets never go to git
.env
.env.*
*.key
# local tools
.claude/settings.local.json
.vercel
node_modules
.DS_Store
pipeline/cache/
pipeline/out/
# demo video: rendered files and captured media stay local (video/README.md says how to make them)
video/out/
video/public/media/
video/work/
# notes, docs and logs stay on this computer only (round 78); README.md is the only Markdown file on GitHub
*.md
!/README.md
docs/
log/

# Juke tool definitions stay local (round 78)
agent/tools.json
# Python caches (round 103: a tracked .pyc blocked the daily data push)
__pycache__/
*.pyc
